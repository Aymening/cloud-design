# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed. In AWS, these same values are provided via
# Secrets Manager / task definition environment variables instead of a file.

# Inventory database
INVENTORY_DB_USER=appuser
INVENTORY_DB_PASSWORD=changeme
INVENTORY_DB_NAME=movies_db

# Billing database
BILLING_DB_USER=appuser
BILLING_DB_PASSWORD=changeme
BILLING_DB_NAME=billing_db

# RabbitMQ
RABBITMQ_USER=app_user
RABBITMQ_PASSWORD=changeme
RABBITMQ_QUEUE=billing_queue

# API Gateway
GATEWAY_PORT=3000
