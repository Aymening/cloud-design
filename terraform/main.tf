terraform {
  required_version = ">= 1.0.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# -----------------------------------------------------------------------------
# Base IAM Role for ECS Task Execution
# -----------------------------------------------------------------------------
resource "aws_iam_role" "ecs_execution_role" {
  name = "cloud-design-ecs-execution-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ecs-tasks.amazonaws.com"
        }
      }
    ]
  })
}

# Attach AWS Managed Policy for basic ECS task execution (ECR + CloudWatch logs)
resource "aws_iam_role_policy_attachment" "ecs_execution_policy" {
  role       = aws_iam_role.ecs_execution_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

# Centralized CloudWatch log group for container stdout/stderr
resource "aws_cloudwatch_log_group" "ecs_logs" {
  name              = "/ecs/cloud-design"
  retention_in_days = 7
}